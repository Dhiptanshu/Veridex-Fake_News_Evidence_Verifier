# Copy this file to backend/.env (already created for you, blank) and fill in what you want.
# .env is gitignored; never commit keys and never paste them into chat. Every value is optional.
# Restart the API after editing.

# Live Wikipedia search needs no key, but Wikimedia requires contact details in the User-Agent:
FNEV_WIKIPEDIA_CONTACT=

# News evidence. GNews free plan: https://gnews.io/register (key on your dashboard)
FNEV_GNEWS_API_KEY=
# NewsAPI developer plan (alternative): https://newsapi.org/register
FNEV_NEWSAPI_KEY=

# Follow-up answers written by an LLM through AICredits (otherwise a local extractive model answers). Key: https://aicredits.in
FNEV_AICREDITS_API_KEY=
# Optional overrides:
# FNEV_AICREDITS_MODEL=openai/gpt-4o-mini
# FNEV_AICREDITS_BASE_URL=https://api.aicredits.in/v1
