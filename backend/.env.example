# Copy this file to backend/.env and fill in what you want. .env is gitignored; never commit keys.
# Every value is optional: a feature whose value is empty simply stays off.

# Live Wikipedia search needs no key, but Wikimedia requires contact details in the User-Agent:
FNEV_WIKIPEDIA_CONTACT=

# News evidence. GNews free plan: https://gnews.io/register (key on your dashboard)
FNEV_GNEWS_API_KEY=
# NewsAPI developer plan (alternative): https://newsapi.org/register
FNEV_NEWSAPI_KEY=

# Follow-up answers written by Claude (otherwise a local extractive model answers). Key: https://platform.claude.com/settings/keys
FNEV_ANTHROPIC_API_KEY=
# FNEV_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
